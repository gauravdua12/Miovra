# Settings for the website service. setup.sh installs this as /etc/miovra/miovra.env.
# Edit there with: sudo nano /etc/miovra/miovra.env   then: sudo systemctl restart miovra

NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
NEXT_TELEMETRY_DISABLED=1
# Caps Node's memory so the site stays well inside a 1 GB server
# (measured: ~105 MB idle, ~160 MB under heavy load).
NODE_OPTIONS="--max-old-space-size=128 --max-semi-space-size=2"
# Where enquiries and sign-ups are saved (one JSON line each).
MIOVRA_DATA_DIR=/var/lib/miovra

# Email notifications for enquiries and sign-ups (Gmail).
# SMTP_PASS must be a Gmail *App Password* (https://myaccount.google.com/apppasswords),
# not the normal Gmail password. Leave it empty to only save submissions to disk.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=Miovra4u@gmail.com
SMTP_PASS=
MAIL_TO=Miovra4u@gmail.com
MAIL_FROM=Miovra Website <Miovra4u@gmail.com>
