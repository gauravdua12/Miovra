	email Miovra4u@gmail.com
}

www.miovra.eu {
	encode zstd gzip

	# Scripts, styles and photos come straight from disk, so the small server's
	# Node process only renders pages.
	@static path /_next/static/*
	handle @static {
		header Cache-Control "public, max-age=31536000, immutable"
		uri strip_prefix /_next
		root * /opt/miovra/current/.next
		file_server
	}

	@public path /images/* /brand/*
	handle @public {
		header Cache-Control "public, max-age=604800"
		root * /opt/miovra/current/public
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

# Every other address forwards to www.miovra.eu, keeping the page path,
# so there is one address for search engines. Each still gets its own HTTPS certificate.
miovra.eu, miovra.in, www.miovra.in {
	redir https://www.miovra.eu{uri} permanent
}
