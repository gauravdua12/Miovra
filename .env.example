# Copy to .env on the server and fill in. Never commit the real .env.

# Email notifications for enquiries and sign-ups (Gmail example).
# SMTP_PASS must be a Gmail *App Password* (Google Account > Security > 2-Step Verification > App passwords),
# not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=Miovra4u@gmail.com
SMTP_PASS=
MAIL_TO=Miovra4u@gmail.com
MAIL_FROM=Miovra Website <Miovra4u@gmail.com>

# Email Caddy uses to register the HTTPS certificate with Let's Encrypt.
ACME_EMAIL=Miovra4u@gmail.com
